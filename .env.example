# Claude API key from https://console.anthropic.com (owned by Local Host). Without it, AI features run in demo mode.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=
# Optional: max AI requests per IP per hour (default 20) and per day site-wide (default 2000)
AI_RATE_LIMIT_PER_HOUR=
AI_DAILY_CAP=
