# Claude API key from https://console.anthropic.com (owned by Local Host). Without it, AI features run in demo mode.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=
# Optional: max AI requests per IP per hour (default 20) and per day site-wide (default 300)
AI_RATE_LIMIT_PER_HOUR=
AI_DAILY_CAP=
# Optional: shared secret for the staff-only inbox triage tool (/api/triage). Strongly recommended in production:
# when set, triage requests must send it (header X-Staff-Key or cookie lh_staff_key). Generate with: openssl rand -hex 24
STAFF_ACCESS_KEY=
# Optional: time budget for one Claude call in seconds (default 280). Keep it ~20 s below maxDuration in astro.config.mjs.
AI_TIME_LIMIT_SECONDS=
# Optional: "off" disables server-side refusal fallbacks (only needed if ANTHROPIC_MODEL points at a model that rejects them)
AI_FALLBACKS=
