---
/**
 * PREVIEW ONLY (noindex) — 02 Experiences in isolation, for screenshots while
 * other sections are being built. /preview/experiences/en/ · /ka/ · /pl/ …
 * The language comes from the route param, which getLang() reads.
 * The main session deletes src/pages/preview/ before launch.
 */
import Base from '../../../layouts/Base.astro';
import Experiences from '../../../components/sections/Experiences.astro';
import { LANGS } from '../../../i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
---

<Base title="Preview · Experiences" noindex>
  <Experiences />
  <section id="plan" aria-label="Plan (preview stand-in)" style="min-height: 100vh"></section>
</Base>
