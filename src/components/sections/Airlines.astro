---
/**
 * 04 · Airlines (#airlines) — STUB from the foundation.
 * Owned by the Airlines section agent: replace the <Placeholder> with the real
 * section. Strings: src/i18n/<lang>/airlines.json (English is canonical).
 * See docs/ARCHITECTURE.md.
 */
import SectionHead from '../ui/SectionHead.astro';
import Placeholder from '../ui/Placeholder.astro';
import { getLang, useStrings } from '../../i18n';

const lang = getLang(Astro);
const t = useStrings(lang, 'airlines');
---

<section id="airlines" class="section" aria-labelledby="airlines-title">
  <div class="container">
    <SectionHead number={4} id="airlines-title" kicker={t.kicker} title={t.title} intro={t.intro} running={t.running} />
    <Placeholder shape="type" count={12} note="Typography wall of twelve carriers — names set in type, never logos" />
  </div>
</section>
