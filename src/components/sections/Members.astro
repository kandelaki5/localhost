---
/**
 * 07 · Members (#members) — STUB from the foundation.
 * Owned by the Members section agent: replace the <Placeholder> with the real
 * section. Strings: src/i18n/<lang>/members.json (English is canonical).
 * See docs/ARCHITECTURE.md.
 */
import SectionHead from '../ui/SectionHead.astro';
import Placeholder from '../ui/Placeholder.astro';
import { contentLang, getLang, useStrings } from '../../i18n';

const lang = getLang(Astro);
const t = useStrings(lang, 'members');
// English fallback text keeps English typography until this section is translated.
const textLang = contentLang(lang, 'members') === lang ? undefined : 'en';
---

<section lang={textLang} id="members" class="section" aria-labelledby="members-title">
  <div class="container">
    <SectionHead number={7} id="members-title" kicker={t.kicker} title={t.title} intro={t.intro} running={t.running} />
    <Placeholder shape="permits" count={5} note="GNTA · GTA · CEBG · PIT · ŚIT as residence-permit stamps" />
  </div>
</section>
