---
/**
 * 03 · Hosts (#hosts) — STUB from the foundation.
 * Owned by the Hosts section agent: replace the <Placeholder> with the real
 * section. Strings: src/i18n/<lang>/hosts.json (English is canonical).
 * See docs/ARCHITECTURE.md.
 */
import SectionHead from '../ui/SectionHead.astro';
import Placeholder from '../ui/Placeholder.astro';
import { getLang, useStrings } from '../../i18n';

const lang = getLang(Astro);
const t = useStrings(lang, 'hosts');
---

