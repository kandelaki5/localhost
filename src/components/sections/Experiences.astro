---
/**
 * 02 · Experiences (#experiences) — six perforated stamp cards in a
 * native scroll-snap carousel: Culture, Wine, Trekking, Gastronomy,
 * Pilgrim, Leisure.
 *
 * - Names, places and seasons come from the AI knowledge base
 *   (src/lib/ai/knowledge.ts) via ./experiences/data.ts, so the cards and
 *   the AI planner never disagree. Copy lives in i18n/<lang>/experiences.json.
 * - The track bleeds to the page edges: its inline padding lines the first
 *   card up with the container, so the next card peeks in from the margin.
 * - Without JS it is a plain horizontally scrolling list (touch, trackpad,
 *   scrollbar) and the controls stay hidden. ./experiences/carousel.ts adds
 *   prev/next, the "01–03 / 06" counter, the progress bar, arrow keys and the
 *   `lh:plan-preset` event for the planner (#plan).
 */
import SectionHead from '../ui/SectionHead.astro';
import Icon from '../ui/Icon.astro';
import ExperienceCard from './experiences/ExperienceCard.astro';
import { EXPERIENCE_CARDS } from './experiences/data';
import { contentLang, getLang, useStrings } from '../../i18n';

const lang = getLang(Astro);
const t = useStrings(lang, 'experiences');
// English fallback text keeps English typography until this section is translated.
const textLang = contentLang(lang, 'experiences') === lang ? undefined : 'en';
const total = String(EXPERIENCE_CARDS.length).padStart(2, '0');
---

<section
  lang={textLang}
  id="experiences"
  class="section experiences"
  aria-labelledby="experiences-title"
  data-status={t.carousel.status}
  data-status-one={t.carousel.statusOne}
>
  <div class="container">
    <SectionHead number={2} id="experiences-title" kicker={t.kicker} title={t.title} intro={t.intro} running={t.running}>
      <div class="exp-ctrl" data-exp-controls>
        <button type="button" class="exp-ctrl__btn" aria-label={t.carousel.prev} aria-controls="experiences-track" disabled data-exp-prev>
          <Icon name="arrow-left" size={20} />
        </button>
        <button type="button" class="exp-ctrl__btn" aria-label={t.carousel.next} aria-controls="experiences-track" data-exp-next>
          <Icon name="arrow-right" size={20} />
        </button>
        <p class="exp-ctrl__count" aria-live="polite" aria-atomic="true">
          <span class="exp-ctrl__range" aria-hidden="true" data-exp-range>01–03</span>
          <span class="exp-ctrl__total" aria-hidden="true">/ {total}</span>
          <span class="visually-hidden" data-exp-status></span>
        </p>
        <span class="exp-ctrl__bar" aria-hidden="true">
          <span class="exp-ctrl__thumb" data-exp-thumb></span>
        </span>
      </div>
    </SectionHead>
  </div>

  <ul class="exp-track" id="experiences-track" role="list" aria-label={t.carousel.label} data-exp-track>
    {
      EXPERIENCE_CARDS.map((card) => (
        <li class="exp-track__item" data-exp-item>
          <ExperienceCard card={card} />
        </li>
      ))
    }
  </ul>
</section>

<script>
  import { initExperiences } from './experiences/carousel';

  const root = document.getElementById('experiences');
  if (root) initExperiences(root);
</script>

<style>
  /* Desktop: keep the right-edge lane free for the section rail, so the
     peeking card never sits under it (the last card still scrolls fully into
     the content column). */
  @media (min-width: 75em) {
    .exp-track {
      -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 3rem), transparent calc(100% - 3rem));
      mask-image: linear-gradient(90deg, #000 calc(100% - 3rem), transparent calc(100% - 3rem));
    }
  }

  /* ── controls (in the section head, under the intro) ── */
  .exp-ctrl {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    justify-self: stretch;
    margin-top: var(--space-2xs);
  }

  /* Prev/next need the script; without it the track is scrolled directly. */
  @media (scripting: none) {
    .exp-ctrl {
      display: none;
    }
  }

  .exp-ctrl__btn {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border: var(--border-hair) solid var(--color-bg-inverse);
    border-radius: var(--radius-round);
    color: var(--color-text);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out);
  }

  .exp-ctrl__btn:focus-visible {
    border-radius: var(--radius-round);
  }

  .exp-ctrl__btn:hover:not(:disabled) {
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
  }

  .exp-ctrl__btn:disabled {
    opacity: var(--opacity-disabled);
    cursor: default;
  }

  .exp-ctrl__count {
    display: flex;
    align-items: baseline;
    gap: 0.35em;
    flex: none;
    min-width: 5.25rem;
    margin-left: var(--space-2xs);
    white-space: nowrap;
  }

  .exp-ctrl__range {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-lg);
    font-weight: var(--fw-display-sm);
    font-variation-settings: var(--fvs-caption);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .exp-ctrl__total {
    font-size: var(--fs-2xs);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-caps);
    color: var(--color-text-muted);
  }

  .exp-ctrl__bar {
    position: relative;
    flex: 1;
    min-width: var(--space-xl);
    height: var(--border-hair);
    background: var(--color-rule-strong);
  }

  .exp-ctrl__thumb {
    position: absolute;
    left: 0;
    top: calc(-1 * var(--border-hair));
    width: 50%;
    height: var(--border-heavy);
    background: var(--color-text);
    transform-origin: 0 50%;
  }

  /* ── the track ── */
  .exp-track {
    /* Lines the first card up with .container; percentages resolve against the section width. */
    --exp-inset: max(var(--layout-gutter), calc((100% - var(--layout-max)) / 2));
    --exp-gap: var(--layout-gap);
    --exp-card: 84%;
    position: relative;
    display: flex;
    /* Equal-height cards, so each card's action can sit on one shared line. */
    align-items: stretch;
    gap: var(--exp-gap);
    margin: 0;
    /* Room for the hover lift, the focus ring and the stamp shadows. */
    padding: var(--space-s) var(--exp-inset) var(--space-l);
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--exp-inset);
    scrollbar-width: thin;
    scrollbar-color: var(--color-rule-strong) transparent;
  }

  /* The script adds buttons, a counter and a progress bar: the scrollbar can go. */
  @media (scripting: enabled) {
    .exp-track {
      scrollbar-width: none;
    }

    .exp-track::-webkit-scrollbar {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .exp-track {
      scroll-behavior: smooth;
    }
  }

  .exp-track__item {
    flex: 0 0 var(--exp-card);
    min-width: 0;
    scroll-snap-align: start;
  }

  /* tablet: two cards and a peek of the third */
  @media (min-width: 40em) {
    .exp-track {
      --exp-card: calc((100% - var(--exp-gap)) / 2.2);
    }
  }

  /* desktop: three cards, the middle one of each three set lower (editorial stagger) */
  @media (min-width: 64em) {
    .exp-track {
      --exp-gap: calc(var(--layout-gap) + var(--space-2xs));
      --exp-card: calc((100% - 2 * var(--exp-gap)) / 3);
    }

    .exp-track__item:nth-child(3n + 2) {
      margin-top: var(--space-m);
    }
  }

  /* ── entrance: only when motion is allowed and the script armed it ── */
  @media (prefers-reduced-motion: no-preference) {
    .experiences[data-reveal] .exp-track__item {
      transition:
        opacity var(--dur-slower) var(--ease-out),
        transform var(--dur-slower) var(--ease-out);
    }

    .experiences[data-reveal='pending'] .exp-track__item {
      opacity: 0;
      transform: translateY(var(--space-l));
    }

    .experiences[data-reveal='done'] .exp-track__item:nth-child(2) {
      transition-delay: calc(1 * var(--dur-stagger));
    }

    .experiences[data-reveal='done'] .exp-track__item:nth-child(3) {
      transition-delay: calc(2 * var(--dur-stagger));
    }

    .experiences[data-reveal='done'] .exp-track__item:nth-child(n + 4) {
      transition-delay: calc(3 * var(--dur-stagger));
    }
  }
</style>
