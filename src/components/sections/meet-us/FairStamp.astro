---
/**
 * One trade fair as a visa ink stamp: country, city (italic serif), fair name
 * (small caps), the dates of the edition on show and the organiser's domain.
 * The whole stamp is the link to the official site (stretched link).
 *
 * `data-state` (now · next · upcoming · held) drives the look: the next fair
 * is a solid "inked" stamp with a tag, a running fair gets an "On now" tag,
 * a fair whose dates are all past is cancelled with wavy postmark lines.
 * The client script in MeetUs.astro re-checks the state against today.
 */
import Icon from '../../ui/Icon.astro';
import { encodeEdition, type FairState } from './schedule';
import type { Fair } from './data';

interface Props {
  fair: Fair;
  city: string;
  state: FairState;
  /** Formatted dates of the edition on show, e.g. "14–16 Oct 2026". */
  when: string;
  /** ISO start of that edition (for <time datetime>). */
  whenIso: string;
  /** Pre-formatted labels of both known editions, so the client re-check never formats dates itself. */
  labels: { last?: { range: string; until: string }; next?: { range: string; until: string } };
  tag: string;
  tba: string;
  official: string;
  newTab: string;
  index: number;
}

const { fair, city, state, when, whenIso, labels, tag, tba, official, newTab, index } = Astro.props;
---

<li
  class="fair"
  data-stamp
  data-fair={fair.id}
  data-state={state}
  data-shape={fair.shape}
  data-ink={fair.ink}
  data-name={fair.name}
  data-city={city}
  data-last={encodeEdition(fair.last)}
  data-last-range={labels.last?.range}
  data-last-until={labels.last?.until}
  data-next={encodeEdition(fair.next)}
  data-next-range={labels.next?.range}
  data-next-until={labels.next?.until}
  style={`--tilt:${fair.tilt}deg;--i:${index}`}
>
  <div class="fair__stamp">
    <span class="fair__frame" aria-hidden="true"></span>
    <svg class="fair__cancel" viewBox="0 0 240 70" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path d="M2 12q15-9 30 0t30 0 30 0 30 0 30 0 30 0 30 0 30 0" />
      <path d="M2 28q15-9 30 0t30 0 30 0 30 0 30 0 30 0 30 0 30 0" />
      <path d="M2 44q15-9 30 0t30 0 30 0 30 0 30 0 30 0 30 0 30 0" />
      <path d="M2 60q15-9 30 0t30 0 30 0 30 0 30 0 30 0 30 0 30 0" />
    </svg>

    <span class="fair__tag" data-role="tag" hidden={!tag}>{tag}</span>

    <h4 class="fair__name">
      <a class="fair__link" href={fair.url} target="_blank" rel="noopener" aria-describedby={`fair-desc-${fair.id}`} data-m-title>
        {fair.name}
      </a>
    </h4>
    <span id={`fair-desc-${fair.id}`} hidden>{official} ({newTab})</span>
    <p class="fair__city">{city}</p>
    <p class="fair__cc" aria-hidden="true">
      <Icon name="plane" size={11} class="fair__plane" />
      {fair.countryCode}
    </p>
    <p class="fair__when">
      <time data-role="when" datetime={whenIso}>{when}</time>
    </p>
    <p class="fair__tba" data-role="tba" hidden={state !== 'held'}>{tba}</p>
    <p class="fair__domain" aria-hidden="true">
      {fair.domain}
      <Icon name="arrow-up-right" size={11} strokeWidth={1.75} />
    </p>
  </div>
</li>

<style>
  .fair {
    --_ink: var(--color-text);
    --_fg: var(--color-text);
    --_radius: var(--radius-sm);
    --_pad: clamp(0.5rem, 0.2rem + 0.8vw, 0.875rem);
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-inline: var(--_pad);
  }

  .fair[data-ink='green'] {
    --_ink: var(--color-green-ink);
    --_fg: var(--color-green-ink);
  }

  /* ── the stamp ── */
  .fair__stamp {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 13.5rem;
    min-height: 12.75rem;
    padding: var(--space-m) var(--space-s) var(--space-s);
    color: var(--_fg);
    text-align: center;
    transform: rotate(var(--tilt));
    transition: transform var(--dur-base) var(--ease-out);
  }

  .fair:hover .fair__stamp,
  .fair:focus-within .fair__stamp {
    transform: rotate(0deg) translateY(-3px);
  }

  /* Rubber-stamp frame: its own layer, so the ink texture never touches the text. */
  .fair__frame {
    position: absolute;
    inset: 0;
    border: var(--border-heavy) solid var(--_ink);
    border-radius: var(--_radius);
    -webkit-mask-image: var(--texture-ink);
    mask-image: var(--texture-ink);
    -webkit-mask-size: 160px;
    mask-size: 160px;
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: var(--z-below);
  }

  .fair__frame::after {
    content: '';
    position: absolute;
    inset: 4px;
    border: var(--border-hair) solid var(--_ink);
    border-radius: inherit;
  }

  /* shapes */
  .fair[data-shape='rect'] {
    --_radius: var(--radius-xs);
  }

  .fair[data-shape='double'] .fair__frame {
    border-style: double;
    border-width: 7px;
    border-radius: var(--radius-md);
  }

  .fair[data-shape='double'] .fair__frame::after {
    display: none;
  }

  .fair[data-shape='dashed'] .fair__frame {
    border-style: dashed;
    border-width: var(--border-thick);
  }

  .fair[data-shape='dashed'] .fair__frame::after {
    inset: 6px;
  }

  .fair[data-shape='oval'] .fair__stamp,
  .fair[data-shape='round'] .fair__stamp {
    --_radius: var(--radius-round);
    padding-inline: var(--space-m);
  }

  .fair[data-shape='round'] .fair__stamp {
    aspect-ratio: 1;
    min-height: 0;
    padding-block: var(--space-s);
  }

  .fair[data-shape='round'] .fair__when {
    max-width: 10rem;
    padding-inline: 0.25rem;
    letter-spacing: 0.02em;
  }

  .fair[data-shape='oval'] .fair__stamp {
    aspect-ratio: 0.86;
    min-height: 0;
  }

  .fair[data-shape='round'] .fair__frame::after {
    inset: 6px;
  }

  .fair[data-shape='arch'] .fair__stamp {
    --_radius: 50% 50% var(--radius-sm) var(--radius-sm) / 34% 34% var(--radius-sm) var(--radius-sm);
    padding-top: var(--space-xl);
  }

  /* ── face (DOM order: name first for assistive tech; shown city first) ── */
  .fair__cc {
    order: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--latin-tracking-caps);
    line-height: 1;
  }

  .fair__city {
    order: 2;
    margin-top: var(--space-2xs);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.625rem, 1.25rem + 0.9vw, 2.125rem);
    font-weight: var(--fw-display-sm);
    font-variation-settings: var(--fvs-accent);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .fair__city:lang(ka) {
    font-family: var(--font-ka-display);
    font-style: normal;
    font-size: clamp(1.25rem, 1rem + 0.6vw, 1.5rem);
    font-weight: var(--fw-ka-text);
    line-height: 1.2;
  }

  .fair__name {
    order: 3;
    color: inherit;
    margin-top: 0.45rem;
    font-family: var(--font-text);
    font-size: var(--fs-2xs);
    font-weight: var(--fw-bold);
    line-height: 1.25;
    /* fair names are Latin brand names: Latin small caps on every page */
    letter-spacing: var(--latin-tracking-caps);
    text-transform: uppercase;
  }

  .fair__link {
    color: inherit;
    text-decoration: none;
  }

  /* Stretched link: the whole stamp opens the official site. */
  .fair__link::after {
    content: '';
    position: absolute;
    inset: -2px;
    z-index: var(--z-raised);
    border-radius: var(--_radius);
  }

  .fair__link:focus-visible {
    outline: none;
  }

  .fair__link:focus-visible::after {
    outline: var(--border-thick) solid var(--color-focus);
    outline-offset: 4px;
  }

  .fair__when {
    order: 4;
    width: 100%;
    max-width: 10.5rem;
    margin-top: var(--space-xs);
    padding-top: var(--space-xs);
    border-top: var(--border-hair) solid color-mix(in srgb, currentColor 45%, transparent);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-mono);
    line-height: 1.3;
    text-transform: var(--case-caps);
    font-variant-numeric: tabular-nums;
  }

  .fair__when:lang(ka) {
    font-family: var(--font-ka-text);
    font-weight: var(--fw-semibold);
  }

  .fair__tba {
    order: 5;
    max-width: 12rem;
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-xs);
    font-variation-settings: var(--fvs-caption);
    line-height: 1.25;
  }

  .fair__tba:lang(ka) {
    font-family: var(--font-ka-text);
    font-style: normal;
  }

  .fair__domain {
    order: 6;
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    margin-top: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--fs-3xs);
    letter-spacing: 0.02em;
  }

  .fair:hover .fair__domain {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* ── state tags ── */
  .fair__tag {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: var(--z-raised);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.55rem;
    transform: translate(-50%, -55%);
    background: var(--color-bg);
    font-family: var(--font-text);
    font-size: var(--fs-3xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: var(--case-caps);
    line-height: 1.2;
    white-space: nowrap;
  }

  .fair__tag::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: var(--radius-round);
    background: currentColor;
  }

  .fair__tag:lang(ka) {
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
  }

  .fair[data-state='next'] .fair__tag {
    color: var(--color-red-ink);
  }

  .fair[data-state='next'] .fair__tag::before {
    background: var(--color-accent);
  }

  .fair[data-state='now'] .fair__tag {
    color: var(--color-green-ink);
  }

  .fair[data-state='now'] .fair__tag::before {
    background: var(--color-led);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-led) 25%, transparent);
  }

  /* next: a solid, freshly inked stamp */
  .fair[data-state='next'] .fair__stamp {
    color: var(--color-text-inverse);
  }

  .fair[data-state='next'] .fair__frame::after {
    display: none;
  }

  .fair[data-state='next'] .fair__stamp::before {
    content: '';
    position: absolute;
    inset: 6px;
    z-index: var(--z-below);
    border-radius: var(--_radius);
    background: var(--_ink);
  }

  .fair[data-state='next'][data-shape='double'] .fair__stamp::before {
    inset: 9px;
    border-radius: calc(var(--radius-md) - 6px);
  }


  /* held: dates are past and the next ones aren't out yet — cancelled */
  .fair__cancel {
    display: none;
  }

  .fair[data-state='held'] .fair__stamp {
    opacity: 0.72;
  }

  .fair[data-state='held'] .fair__cancel {
    display: block;
    position: absolute;
    top: 12%;
    left: -6%;
    width: 112%;
    height: 30%;
    fill: none;
    stroke: var(--color-text);
    stroke-width: 2.6;
    stroke-linecap: round;
    z-index: var(--z-raised);
    opacity: 0.42;
    mix-blend-mode: multiply;
    transform: rotate(-8deg);
    pointer-events: none;
  }

  /* six across on the year ruler: round and oval stamps have no room for the
     domain line (the whole stamp is still the link) */
  @media (min-width: 80em) {
    .fair[data-shape='oval'] .fair__domain,
    .fair[data-shape='round'] .fair__domain {
      display: none;
    }
  }

  /* six across on the year ruler (1280–1439): the tightest cells */
  @media (min-width: 80em) and (max-width: 89.99em) {
    .fair__stamp {
      padding-inline: var(--space-xs);
    }

    .fair[data-shape='oval'] .fair__stamp,
    .fair[data-shape='round'] .fair__stamp {
      padding-inline: var(--space-s);
    }

    .fair__when {
      font-size: var(--fs-2xs);
      letter-spacing: 0.01em;
    }
  }

  .fair[data-shape='round'] .fair__city,
  .fair[data-shape='round'] .fair__domain {
    margin-top: 0.3rem;
  }

  .fair[data-shape='round'] .fair__when {
    margin-top: var(--space-2xs);
    padding-top: var(--space-2xs);
  }

  /* ── entrance: each stamp is pressed onto the page once it scrolls in ── */
  @media screen and (prefers-reduced-motion: no-preference) {
    :global([data-reveal='ready']) .fair:not([data-revealed]) .fair__stamp {
      opacity: 0;
    }

    :global([data-reveal='ready']) .fair[data-revealed] .fair__stamp {
      animation: fair-press var(--dur-base) var(--ease-overshoot) backwards;
      animation-delay: calc(var(--i, 0) * var(--dur-stagger));
    }
  }

  @keyframes fair-press {
    from {
      opacity: 0;
      transform: rotate(calc(var(--tilt) - 5deg)) scale(1.22);
    }
    55% {
      opacity: 1;
    }
  }

  /* ── phone: landscape stamps ── */
  @media (max-width: 39.99em) {
    .fair {
      display: block;
      padding-inline: 0;
    }

    .fair__stamp,
    .fair[data-shape] .fair__stamp {
      display: grid;
      /* the date column wraps before a city name breaks (Warschau, Poznań) */
      grid-template-columns: minmax(min-content, 1fr) auto;
      grid-template-areas:
        'cc when'
        'city when'
        'name domain'
        'tba tba';
      align-items: center;
      column-gap: var(--space-s);
      max-width: none;
      min-height: 0;
      aspect-ratio: auto;
      padding: var(--space-m) var(--space-m) var(--space-s);
      text-align: start;
    }

    .fair[data-shape='oval'] .fair__stamp,
    .fair[data-shape='round'] .fair__stamp {
      --_radius: var(--radius-pill);
      padding-inline: var(--space-l);
    }

    .fair[data-shape='arch'] .fair__stamp {
      --_radius: var(--radius-lg) var(--radius-lg) var(--radius-sm) var(--radius-sm);
      padding-top: var(--space-m);
    }

    .fair__cc {
      grid-area: cc;
    }

    .fair__city {
      overflow-wrap: normal;
      grid-area: city;
      margin-top: 0.3rem;
    }

    .fair__name {
      grid-area: name;
      margin-top: 0.35rem;
    }

    .fair__when {
      grid-area: when;
      align-self: stretch;
      justify-self: end;
      display: flex;
      align-items: center;
      width: auto;
      max-width: 8.5rem;
      margin: 0;
      padding: 0.15rem 0 0.15rem var(--space-s);
      border-top: 0;
      border-left: var(--border-hair) solid color-mix(in srgb, currentColor 45%, transparent);
      text-align: start;
    }

    .fair__domain {
      grid-area: domain;
      justify-self: end;
      margin: 0.35rem 0 0;
    }

    .fair__tba {
      grid-area: tba;
      max-width: none;
      margin-top: var(--space-2xs);
    }

    .fair__tag {
      left: var(--space-l);
      transform: translate(0, -55%);
    }
  }

  /* ≤ 360 px: a date column beside the city leaves too little room for
     "Warschau" or "Poznań" next to a long German date, so the date moves
     under the city and city names never break mid-word. */
  @media (max-width: 22.49em) {
    .fair__stamp,
    .fair[data-shape] .fair__stamp {
      grid-template-areas:
        'cc cc'
        'city city'
        'when when'
        'name domain'
        'tba tba';
    }

    .fair__city {
      overflow-wrap: normal;
    }

    .fair__when {
      justify-self: stretch;
      align-self: auto;
      max-width: none;
      margin-top: var(--space-2xs);
      padding: var(--space-2xs) 0 0;
      border-left: 0;
      border-top: var(--border-hair) solid color-mix(in srgb, currentColor 45%, transparent);
    }
  }

  /* ── Proposal ?proposal=compact (phones): one dated row per fair ──────────
       [✈ IT]  City                     dates
               FAIR NAME ↗       ● state tag
     The stamp shrinks to a small ink mark in the fair's own shape and ink, on
     a hairline-ruled list; the whole row stays the link (stretched). Only
     with html[data-proposal~='compact'] and below 40em: elsewhere the stamps
     above apply unchanged. */
  @media (max-width: 39.99em) {
    :global(html[data-proposal~='compact']) .fair {
      --_mark: 2.5rem;
      /* room always kept for the longest fair name + arrow ("TOUR SALON ↗") */
      --_name: 6.5rem;
      border-bottom: var(--border-hair) solid var(--color-rule);
    }

    :global(html[data-proposal~='compact']) .fair[data-shape] .fair__stamp {
      display: grid;
      /* the dates wrap before the fair name does (long German dates on
         320px phones); city and fair name never break mid-word */
      grid-template-columns:
        var(--_mark) minmax(min-content, 1fr)
        fit-content(calc(100% - var(--_mark) - 2 * var(--space-xs) - var(--_name)));
      grid-template-areas:
        'mark city when'
        'mark name tag'
        'mark tba tba';
      align-items: baseline;
      column-gap: var(--space-xs);
      row-gap: 0;
      min-height: 0;
      aspect-ratio: auto;
      padding: var(--space-xs) 0;
      color: var(--_fg);
      text-align: start;
      transform: none;
      isolation: isolate;
    }

    :global(html[data-proposal~='compact']) .fair[data-shape]:is(:hover, :focus-within) .fair__stamp {
      transform: none;
    }

    :global(html[data-proposal~='compact']) .fair[data-shape] .fair__stamp::before {
      content: none;
    }

    /* the mini stamp: frame + "✈ IT", pressed slightly askew */
    :global(html[data-proposal~='compact']) .fair[data-shape] .fair__frame,
    :global(html[data-proposal~='compact']) .fair[data-shape] .fair__cc {
      grid-area: mark;
      align-self: center;
      justify-self: center;
      transform: rotate(calc(var(--tilt) * 2.5));
      transition: transform var(--dur-base) var(--ease-out);
    }

    :global(html[data-proposal~='compact']) .fair[data-shape]:is(:hover, :focus-within) :is(.fair__frame, .fair__cc) {
      transform: none;
    }

    :global(html[data-proposal~='compact']) .fair[data-shape] .fair__frame {
      position: relative;
      inset: auto;
      width: var(--_mark);
      height: var(--_mark);
      border-width: var(--border-heavy);
      border-style: solid;
      border-radius: var(--radius-xs);
    }

    :global(html[data-proposal~='compact']) .fair[data-shape] .fair__frame::after {
      inset: var(--border-heavy);
    }

    :global(html[data-proposal~='compact']) .fair[data-shape='double'] .fair__frame {
      border-style: double;
      border-width: calc(var(--border-heavy) + var(--border-thick));
      border-radius: var(--radius-sm);
    }

    :global(html[data-proposal~='compact']) .fair[data-shape='dashed'] .fair__frame {
      border-style: dashed;
      border-width: var(--border-thick);
    }

    :global(html[data-proposal~='compact']) .fair[data-shape='round'] .fair__frame {
      border-radius: var(--radius-round);
    }

    :global(html[data-proposal~='compact']) .fair[data-shape='oval'] .fair__frame {
      width: calc(var(--_mark) * 0.84);
      border-radius: var(--radius-round);
    }

    :global(html[data-proposal~='compact']) .fair[data-shape='arch'] .fair__frame {
      width: calc(var(--_mark) * 0.9);
      border-radius: 50% 50% var(--radius-xs) var(--radius-xs) / 42% 42% var(--radius-xs) var(--radius-xs);
    }

    :global(html[data-proposal~='compact']) .fair[data-shape] .fair__cc {
      z-index: var(--z-raised);
      flex-direction: column;
      gap: 0.15rem;
      margin: 0;
    }

    :global(html[data-proposal~='compact']) .fair[data-shape='arch'] .fair__cc {
      margin-top: 0.2rem;
    }

    /* next: the mark is freshly inked (solid), the row itself stays on paper */
    :global(html[data-proposal~='compact']) .fair[data-state='next'] .fair__frame {
      background: var(--_ink);
    }

    :global(html[data-proposal~='compact']) .fair[data-state='next'] .fair__cc {
      color: var(--color-text-inverse);
    }

    :global(html[data-proposal~='compact']) .fair[data-shape] .fair__city {
      grid-area: city;
      /* sits on the last line of a wrapped date, right above the fair name */
      align-self: last baseline;
      margin: 0;
      font-size: var(--fs-lg);
      line-height: 1;
      overflow-wrap: normal;
    }

    :global(html[data-proposal~='compact']) .fair[data-shape] .fair__city:lang(ka) {
      font-size: var(--fs-md);
      line-height: 1.2;
    }

    :global(html[data-proposal~='compact']) .fair[data-shape] .fair__name {
      grid-area: name;
      margin: var(--space-3xs) 0 0;
    }

    /* the domain line gives way to an "opens the official site" arrow */
    :global(html[data-proposal~='compact']) .fair[data-shape] .fair__domain {
      display: none;
    }

    :global(html[data-proposal~='compact']) .fair[data-shape] .fair__name::after {
      content: '';
      display: inline-block;
      width: 1em;
      height: 1em;
      margin-inline-start: 0.25em;
      vertical-align: -0.1em;
      background: currentColor;
