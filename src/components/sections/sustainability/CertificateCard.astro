---
/**
 * The template's "certificate screen", designed as a document card: the
 * register facts (holder, level, first approved, valid until) typeset on a
 * double-ruled sheet with a link to verify them in the public register.
 * Until the owner sends the certificate scan (CERTIFICATE_IMAGE in ./data.ts)
 * the facts carry the card on their own, with a typeset green seal; once the
 * scan lands it is shown above them and the seal steps aside. Never an
 * imitation of Travelife's own certificate or logo.
 */
import { Picture } from 'astro:assets';
import Icon from '../../ui/Icon.astro';
import { getLang, useStrings } from '../../../i18n';
import Seal from '../../ui/Seal.astro';
import { CERTIFICATE_IMAGE, TRAVELIFE, TRAVELIFE_BADGE, TRAVELIFE_REGISTER_URL } from './data';
import { formatDate } from './format';

interface Props {
  /** id for the card heading (the section is the landmark; this is a sub-heading). */
  headingId: string;
  class?: string;
}

const { headingId, class: className } = Astro.props;
const lang = getLang(Astro);
const t = useStrings(lang, 'sustainability');
const common = useStrings(lang, 'common');
const c = t.certificate;
const first = formatDate(TRAVELIFE.firstApproval, lang);
const valid = formatDate(TRAVELIFE.validUntil, lang);
const span = `${TRAVELIFE.firstApproval.slice(0, 4)}–${TRAVELIFE.validUntil.slice(0, 4)}`;
---

<article class:list={['cert', className, !CERTIFICATE_IMAGE && 'cert--typeset']} aria-labelledby={headingId}>
  <header class="cert__head">
    <h4 id={headingId} class="cert__kicker kicker">{c.kicker}</h4>
    <span class="cert__span" aria-hidden="true">{span}</span>
  </header>

  {
    CERTIFICATE_IMAGE ? (
      <div class="cert__sheet">
        <Picture
          src={CERTIFICATE_IMAGE}
          alt={c.imageAlt}
          formats={['avif', 'webp']}
          widths={[480, 720, 960]}
          sizes="(min-width: 64em) 30vw, 90vw"
          class="cert__img"
        />
      </div>
    ) : null
  }

  <div class="cert__doc">
    <dl class="cert__facts">
      <div class="cert__row cert__row--holder">
        <dt>{c.holderLabel}</dt>
        <dd>{c.holder}</dd>
      </div>
      <div class="cert__row cert__row--level">
        <dt>{c.levelLabel}</dt>
        <dd>{c.level}</dd>
      </div>
      <div class="cert__row cert__row--date">
        <dt>{c.firstLabel}</dt>
        <dd><time datetime={TRAVELIFE.firstApproval}>{first}</time></dd>
      </div>
      <div class="cert__row cert__row--date">
        <dt>{c.validLabel}</dt>
        <dd><time datetime={TRAVELIFE.validUntil}>{valid}</time></dd>
      </div>
    </dl>
    {
      !CERTIFICATE_IMAGE && (
        <Seal
          tone="green"
          ring={`${TRAVELIFE_BADGE.name.toUpperCase()} · ${TRAVELIFE_BADGE.level.toUpperCase()} • ${span} • `}
          main={TRAVELIFE.firstApproval.slice(0, 4)}
          rotate={-2}
          class="cert__seal"
        />
      )
    }
  </div>

  <footer class="cert__foot">
    <span class="cert__scope">{c.scope}</span>
    <a class="cert__verify" href={TRAVELIFE_REGISTER_URL} target="_blank" rel="noopener noreferrer">
      {c.register}
      <Icon name="arrow-up-right" size={14} />
      <span class="visually-hidden">({common.aria.newTab})</span>
    </a>
  </footer>
</article>

<style>
  .cert {
    position: relative;
    display: grid;
    gap: var(--space-s);
    padding: var(--space-m);
    background: var(--color-bg-raised);
    border: var(--border-hair) solid var(--color-rule-strong);
    outline: var(--border-hair) solid var(--color-rule-strong);
    outline-offset: calc(-1 * var(--space-2xs));
    box-shadow: var(--shadow-md);
  }

  .cert__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    padding-inline: var(--space-3xs);
  }

  .cert__kicker {
    margin: 0;
    color: var(--color-text);
  }

  .cert__span {
    font-family: var(--font-mono);
    font-size: var(--fs-3xs);
    letter-spacing: var(--tracking-mono);
    color: var(--color-text-muted);
  }

  /* ── certificate scan (once the owner sends it) ── */
  .cert__sheet {
    position: relative;
    aspect-ratio: 1.414 / 1;
    background: var(--color-bg-sunken);
    overflow: hidden;
  }

  .cert__sheet :global(.cert__img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ── the typeset certificate ── */
  .cert__doc {
    position: relative;
  }

  .cert--typeset .cert__doc {
    padding: var(--space-m) var(--space-m) var(--space-s);
    background: var(--color-bg);
    border: var(--border-hair) solid var(--color-rule-strong);
    outline: var(--border-hair) solid var(--color-rule);
    outline-offset: calc(-1 * var(--space-3xs));
  }

  .cert__facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-m);
    margin: 0;
    padding-inline: var(--space-3xs);
  }

  .cert__row {
    display: grid;
    align-content: start;
    gap: 0.15rem;
    padding-block: var(--space-xs);
    border-top: var(--border-hair) solid var(--color-rule);
  }

  .cert__row dt {
    font-size: var(--fs-3xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: var(--case-caps);
    color: var(--color-text-muted);
  }

  .cert__row dt:lang(ka) {
    font-size: var(--fs-2xs);
    font-weight: var(--fw-medium);
  }

  .cert__row dd {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    line-height: 1.35;
    color: var(--color-text);
  }

  /* typeset: holder and level set like the title lines of a certificate */
  .cert--typeset .cert__facts {
    padding-inline: 0;
  }

  .cert--typeset .cert__row--holder,
  .cert--typeset .cert__row--level {
    grid-column: 1 / -1;
    border-top: 0;
  }

  .cert--typeset .cert__row--holder {
    padding-top: 0;
    /* room for the seal in the top-right corner */
    padding-right: 6.5rem;
  }

  .cert--typeset .cert__row--holder dd {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: var(--fw-display-sm);
    font-variation-settings: var(--fvs-heading);
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
    text-wrap: balance;
  }

  .cert--typeset .cert__row--level {
    padding-top: 0;
    padding-bottom: var(--space-s);
  }

  .cert--typeset .cert__row--level dd {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-lg);
    font-weight: var(--fw-display-sm);
    font-variation-settings: var(--fvs-accent);
    line-height: 1.15;
    color: var(--color-emphasis);
  }

  .cert--typeset .cert__row--level dd:lang(ka),
  .cert--typeset .cert__row--holder dd:lang(ka) {
    font-style: normal;
  }

  .cert--typeset .cert__row--date dd {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-mono);
  }

  .cert :global(.cert__seal) {
    --seal-size: 6rem;
    position: absolute;
    top: calc(-1 * var(--space-xs));
    right: calc(-1 * var(--space-2xs));
  }

  /* ── foot ── */
  .cert__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    padding: var(--space-xs) var(--space-3xs) 0;
    border-top: var(--border-hair) solid var(--color-rule-strong);
  }

  .cert__scope {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-xs);
    font-variation-settings: var(--fvs-caption);
    color: var(--color-text-muted);
  }

  .cert__verify {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    font-size: var(--fs-2xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: var(--case-caps);
    color: var(--color-link);
    text-decoration: none;
  }

  .cert__verify:hover {
    color: var(--color-link-hover);
    text-decoration: underline;
  }

  .cert__scope:lang(ka) {
    font-family: var(--font-ka-text);
    font-style: normal;
    font-weight: var(--fw-ka-text);
  }

  .cert__verify:lang(ka) {
    font-size: var(--fs-xs);
  }

  /* Tablet: the card runs the full width, so set it as a landscape spread —
     preview on the left, the register facts on the right. */
  @media (min-width: 40em) and (max-width: 63.99em) {
    .cert:not(.cert--typeset) {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      column-gap: var(--space-l);
      align-items: start;
    }

    .cert__head,
    .cert__foot {
      grid-column: 1 / -1;
    }

    .cert:not(.cert--typeset) .cert__facts {
      grid-template-columns: 1fr;
      align-self: center;
    }

    .cert:not(.cert--typeset) .cert__row:last-child {
      border-bottom: var(--border-hair) solid var(--color-rule);
    }
  }

  @media (max-width: 29.99em) {
    .cert--typeset .cert__doc {
      padding-inline: var(--space-s);
    }

    .cert--typeset .cert__row--holder {
      padding-right: 4.5rem;
    }

    .cert :global(.cert__seal) {
      --seal-size: 4.75rem;
    }

    /* dates as ledger lines: label left, date right, one line each */
    .cert--typeset .cert__facts {
      grid-template-columns: minmax(0, 1fr);
    }

    .cert--typeset .cert__row--date {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.15rem var(--space-s);
      padding-block: var(--space-2xs);
    }
  }

  @media (max-width: 23.99em) {
    .cert:not(.cert--typeset) .cert__facts {
      grid-template-columns: 1fr;
    }
  }
</style>
