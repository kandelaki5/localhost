---
/** One commitment pictogram (decorative: the commitment's title names it). */
import { GLYPHS, type GlyphName } from './glyphs';

interface Props {
  name: GlyphName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['glyph', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
>
  <Fragment set:html={GLYPHS[name]} />
</svg>

<style>
  .glyph {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
