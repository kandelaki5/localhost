---
/**
 * Ink seals from the passport graft.
 *
 * Round postmark (awards, "Local Host · 2015"): curved ring text on an SVG
 * textPath, double rim, and a centre made of `top` / `main` / `bottom` lines
 * or anything passed in the default slot (e.g. <Logo variant="icon" tone="mono" />).
 *
 *   <Seal ring="WELCOME TO GEORGIA • NATIONAL TOURISM AWARDS •" top="Nominee" main="2016" bottom="Fastest growing" />
 *
 * Permit (memberships, "SAMPLE ITINERARY — DEMO"): a rectangular double-ruled
 * stamp with a label, a big line, a small line and an optional serial.
 *
 *   <Seal variant="permit" top="Member" main="GTA" bottom="Georgian Tourism Association" serial="Nº 02" />
 *
 * Tones: ink (default), green, red, foil (for Forest). Rotation is clamped
 * to ±2°. Decorative by default (aria-hidden); pass `label` to expose it.
 */
import { uid } from '../../lib/uid';

interface Props {
  variant?: 'round' | 'permit';
  tone?: 'ink' | 'green' | 'red' | 'foil' | 'current';
  /** Text set around the ring (round only). End it with " •" so it joins up. */
  ring?: string;
  top?: string;
  main?: string;
  bottom?: string;
  serial?: string;
  /** Degrees, clamped to ±2. */
  rotate?: number;
  /** Diameter (round) or width (permit), CSS length. */
  size?: string;
  /** Rubber-stamp ink texture (uneven ink). */
  inked?: boolean;
  /** Accessible text; omit to hide the seal from assistive tech. */
  label?: string;
  class?: string;
}

const {
  variant = 'round',
  tone = 'ink',
  ring = '',
  top,
  main,
  bottom,
  serial,
  rotate = -1.5,
  size,
  inked = true,
  label,
  class: className,
} = Astro.props;

const deg = Math.max(-2, Math.min(2, rotate));
const pathId = uid('seal-ring');
const R = 77; // ring-text radius in the 200-unit viewBox
const circumference = 2 * Math.PI * R;
const hasSlot = Astro.slots.has('default');
const style = [`--seal-rotate:${deg}deg`, size && `--seal-size:${size}`].filter(Boolean).join(';');
const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---

{
  variant === 'round' ? (
    <div class:list={['seal', 'seal--round', `seal--${tone}`, inked && 'seal--inked', className]} style={style} {...a11y}>
      <svg class="seal__rings" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
        <defs>
          <path id={pathId} d={`M100,100 m-${R},0 a${R},${R} 0 1,1 ${2 * R},0 a${R},${R} 0 1,1 -${2 * R},0`} />
        </defs>
        <circle cx="100" cy="100" r="96" class="seal__rim" />
        <circle cx="100" cy="100" r="91" class="seal__rim seal__rim--thin" />
        <circle cx="100" cy="100" r="63" class="seal__rim seal__rim--inner" />
        {ring && (
          <text class="seal__ring-text">
            <textPath href={`#${pathId}`} textLength={circumference.toFixed(1)} lengthAdjust="spacing">
              {ring}
            </textPath>
          </text>
        )}
      </svg>
      <div class="seal__center">
        {hasSlot ? (
          <slot />
        ) : (
          <>
            {top && <span class="seal__top">{top}</span>}
            {main && <span class="seal__main">{main}</span>}
            {bottom && <span class="seal__bottom">{bottom}</span>}
          </>
        )}
      </div>
    </div>
  ) : (
    <div class:list={['seal', 'seal--permit', `seal--${tone}`, inked && 'seal--inked', className]} style={style} {...a11y}>
      <div class="permit__inner">
        {top && <span class="seal__top">{top}</span>}
        {hasSlot ? <slot /> : main && <span class="seal__main">{main}</span>}
        {bottom && <span class="seal__bottom">{bottom}</span>}
        {serial && <span class="permit__serial">{serial}</span>}
      </div>
    </div>
  )
}

<style>
  .seal {
    --seal-ink: var(--color-text);
    position: relative;
    color: var(--seal-ink);
    transform: rotate(var(--seal-rotate, 0deg));
  }

  .seal--green {
    --seal-ink: var(--color-green-ink);
  }

  .seal--red {
    --seal-ink: var(--color-red-ink);
  }

  .seal--foil {
    --seal-ink: var(--color-foil);
  }

  .seal--current {
    --seal-ink: currentColor;
  }

  /* Uneven rubber-stamp ink. Multiply only on light surfaces. */
  .seal--inked {
    -webkit-mask-image: var(--texture-ink);
    mask-image: var(--texture-ink);
    -webkit-mask-size: 160px;
    mask-size: 160px;
  }

  .seal--inked {
    mix-blend-mode: multiply;
  }

  :global([data-surface='night']) .seal--inked,
  :global([data-surface='forest']) .seal--inked {
    mix-blend-mode: normal;
  }

  /* ── round ── */
  .seal--round {
    width: var(--seal-size, 9.5rem);
    aspect-ratio: 1;
    flex: none;
  }

  .seal__rings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .seal__rim {
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
  }

  .seal__rim--thin {
    stroke-width: 1;
  }

  .seal__rim--inner {
    stroke-width: 1.5;
  }

  .seal__ring-text {
    fill: currentColor;
    font-family: var(--font-mono);
    font-size: 13.5px;
    font-weight: var(--fw-bold);
    letter-spacing: 0.06em;
  }

  .seal__ring-text:lang(ka) {
    font-family: var(--font-ka-text);
    font-size: 13px;
  }

  .seal__center {
    position: absolute;
    inset: 22%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15em;
    text-align: center;
    font-size: calc(var(--seal-size, 9.5rem) / 10);
    line-height: 1.05;
  }

  .seal__center :global(.logo) {
    height: 52%;
  }

  .seal__top,
  .seal__bottom {
    font-family: var(--font-text);
    font-size: 0.62em;
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: var(--case-caps);
  }

  .seal__main {
    font-family: var(--font-display);
    font-size: 1.9em;
    font-style: italic;
    font-weight: var(--fw-display-sm);
    font-variation-settings: var(--fvs-accent);
    letter-spacing: -0.01em;
  }

  .seal__main:lang(ka) {
    font-style: normal;
  }

  /* ── permit ── */
  .seal--permit {
    display: inline-block;
    width: var(--seal-size, auto);
    padding: 4px;
    border: var(--border-heavy) solid currentColor;
    border-radius: var(--radius-sm);
  }

  .permit__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding: var(--space-xs) var(--space-s) var(--space-s);
    border: var(--border-hair) solid currentColor;
    border-radius: var(--radius-xs);
    text-align: center;
  }

  .seal--permit .seal__main {
    font-style: normal;
    font-size: var(--fs-2xl);
    font-weight: var(--fw-display-sm);
    font-variation-settings: var(--fvs-heading);
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .seal--permit .seal__top,
  .seal--permit .seal__bottom {
    font-size: var(--fs-3xs);
  }

  .seal--permit .seal__bottom {
    max-width: 22ch;
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    text-wrap: balance;
  }

  .permit__serial {
    position: absolute;
    top: 0.3rem;
    right: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--fs-3xs);
    letter-spacing: var(--tracking-mono);
  }
</style>
