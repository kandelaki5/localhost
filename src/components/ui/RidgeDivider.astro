---
/**
 * Ridge-line divider (Cinematic graft): a hairline mountain profile with the
 * red sun-pin on its highest peak.
 *
 *   <RidgeDivider />                       paper: static ink hairline
 *   <RidgeDivider variant="night" />       night: glowing brand-green line
 *   <RidgeDivider seed={7} label="Kazbegi" />
 *
 * The line draws itself in when it scrolls into view — only if the visitor
 * allows motion and JS runs; otherwise it is simply there. Each `seed` gives a
 * different (deterministic) ridge.
 */
interface Props {
  variant?: 'paper' | 'night';
  seed?: number;
  /** Small caption next to the pin (e.g. a peak name). */
  label?: string;
  /** Height of the band (CSS length). */
  height?: string;
  pin?: boolean;
  class?: string;
}

const { variant = 'paper', seed = 3, label, height, pin = true, class: className } = Astro.props;

// Deterministic PRNG (mulberry32).
function rng(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const W = 1440;
const H = 120;
const STEP = 12;
const rand = rng(seed * 9973 + 17);
// A few massifs: one dominant summit, two or three lesser ones.
const massifs = [
  { c: 0.38 + rand() * 0.34, w: 0.07 + rand() * 0.05, h: 78 + rand() * 12 },
  { c: 0.08 + rand() * 0.22, w: 0.1 + rand() * 0.08, h: 34 + rand() * 18 },
  { c: 0.78 + rand() * 0.18, w: 0.08 + rand() * 0.08, h: 30 + rand() * 22 },
  { c: rand(), w: 0.04 + rand() * 0.04, h: 14 + rand() * 12 },
];
const pts: [number, number][] = [];
for (let x = 0; x <= W; x += STEP) {
  const u = x / W;
  let lift = 6;
  for (const m of massifs) {
    const d = Math.abs(u - m.c) / m.w;
    lift += m.h * Math.max(0, 1 - d) ** 1.35;
  }
  const jag = (rand() - 0.5) * 7 + (rand() - 0.5) * 3;
  pts.push([x, Math.min(H - 8, Math.max(10, H - 14 - lift + jag))]);
}
let top = 0;
pts.forEach((p, i) => {
  if (p[1] < pts[top][1]) top = i;
});
// Sharpen the summit so the pin sits on a real peak.
pts[top][1] = Math.max(8, pts[top][1] - 3);
const d = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x},${y.toFixed(1)}`).join(' ');
const peak = { x: (pts[top][0] / W) * 100, y: (pts[top][1] / H) * 100 };
---

<div
  class:list={['ridge', `ridge--${variant}`, className]}
  style={height ? `--ridge-h:${height}` : undefined}
  aria-hidden="true"
  data-ridge
>
  <svg class="ridge__svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" focusable="false">
    <path class="ridge__line" d={d} pathLength="1" />
  </svg>
  {
    pin && (
      <span class="ridge__pin" style={`left:${peak.x.toFixed(2)}%;top:${peak.y.toFixed(2)}%`}>
        <svg viewBox="0 0 24 30" width="18" height="23" focusable="false">
          <path
            class="ridge__pin-shape"
            d="M12 1C6.2 1 1.6 5.6 1.6 11.3c0 3 1.2 5.3 3.1 7.4L12 28.5l7.3-9.8c1.9-2.1 3.1-4.4 3.1-7.4C22.4 5.6 17.8 1 12 1Zm0 14.2a3.9 3.9 0 1 1 0-7.8 3.9 3.9 0 0 1 0 7.8Z"
          />
        </svg>
        {label && <span class="ridge__label">{label}</span>}
      </span>
    )
  }
</div>

<style>
  .ridge {
    position: relative;
    height: var(--ridge-h, clamp(3.5rem, 7vw, 6.5rem));
    width: 100%;
    pointer-events: none;
  }

  .ridge__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ridge__line {
    fill: none;
    stroke: var(--color-rule-strong);
    stroke-width: 1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .ridge--night .ridge__line {
    stroke: var(--color-glow);
    stroke-width: 1.4;
    filter: var(--filter-glow);
  }

  .ridge__pin {
    position: absolute;
    transform: translate(-50%, -100%);
    margin-top: -3px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ridge__pin svg {
    display: block;
    overflow: visible;
  }

  .ridge__pin-shape {
    fill: var(--color-accent);
  }

  .ridge--night .ridge__pin svg {
    filter: var(--filter-glow-red);
  }

  .ridge__label {
    position: absolute;
    left: calc(100% + 0.5rem);
    top: 0.1rem;
    font-family: var(--font-mono);
    font-size: var(--fs-3xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* Draw-in: only armed by the script below when motion is allowed. */
  @media (prefers-reduced-motion: no-preference) {
    .ridge[data-draw] .ridge__line {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      transition: stroke-dashoffset var(--dur-draw) var(--ease-film);
    }

    .ridge[data-draw] .ridge__pin {
      opacity: 0;
      translate: 0 -10px;
      transition:
        opacity var(--dur-slow) var(--ease-out) calc(var(--dur-draw) * 0.55),
        translate var(--dur-slow) var(--ease-overshoot) calc(var(--dur-draw) * 0.55);
    }

    .ridge[data-draw='in'] .ridge__line {
      stroke-dashoffset: 0;
    }

    .ridge[data-draw='in'] .ridge__pin {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>

<script>
  const ridges = document.querySelectorAll<HTMLElement>('[data-ridge]:not([data-draw])');
  const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
  if (motionOk && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          (entry.target as HTMLElement).dataset.draw = 'in';
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    ridges.forEach((el) => {
      el.dataset.draw = 'ready';
      io.observe(el);
    });
  }
</script>
