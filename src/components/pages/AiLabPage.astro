---
/**
 * /ai-lab/ — "Local Host AI Lab": the night-mode showcase of every AI feature,
 * each one a working, designed UI (dev harnesses stay under /ai-lab/dev/).
 *
 *   hero (promise + console with demo/live status)
 *   01 Trip Designer & Voice (teaser → /#plan)   02 Photo Match
 *   03 Agency Proposal Builder                    04 Policy Q&A
 *   05 Inquiry Triage (staff tool)                06 MCP connector
 *   How it works / privacy
 *
 * Feature scripts are lazy-loaded (components/ai-lab/client/lazy.ts).
 * Mode: build-time server config, corrected by every response's X-AI-Mode.
 */
import Base from '../../layouts/Base.astro';
import LabHero from '../ai-lab/LabHero.astro';
import MapSprite from '../ai-lab/MapSprite.astro';
import TripTeaser from '../ai-lab/TripTeaser.astro';
import PhotoMatch from '../ai-lab/PhotoMatch.astro';
import ProposalBuilder from '../ai-lab/ProposalBuilder.astro';
import PolicyQa from '../ai-lab/PolicyQa.astro';
import Triage from '../ai-lab/Triage.astro';
import McpConnect from '../ai-lab/McpConnect.astro';
import HowItWorks from '../ai-lab/HowItWorks.astro';
import { aiMode } from '../../lib/ai/config';
import { getLang } from '../../i18n';
import { labStrings } from '../ai-lab/data';
import '../ai-lab/lab.css';
import '../ai-lab/sheet.css';

const lang = getLang(Astro);
const t = labStrings(lang);
const mode = aiMode();
---

<Base title={t.meta.title} description={t.meta.description} surface="night">
  <MapSprite />
  <LabHero mode={mode} />
  <div class="lab-page">
    <TripTeaser />
    <PhotoMatch />
    <ProposalBuilder />
    <PolicyQa />
    <Triage />
    <McpConnect />
    <HowItWorks />
  </div>
</Base>

<script>
  import { boot } from '../ai-lab/client/lazy';
  boot();
</script>

<style>
  .lab-page {
    background: var(--gradient-night-fade) no-repeat;
    background-size: 100% 40rem;
  }
</style>
