---
/**
 * "How it works / privacy" strip at the foot of the AI Lab: Claude by
 * Anthropic, what is sent, no prices or bookings by AI, the team confirms.
 */
import Icon from '../ui/Icon.astro';
import type { IconName } from '../ui/icons';
import { inline } from '../../lib/markup';
import { getLang, useStrings } from '../../i18n';
import { labStrings } from './data';

const lang = getLang(Astro);
const t = labStrings(lang);
const common = useStrings(lang, 'common');
const icons: IconName[] = ['sparkle', 'send', 'x', 'users'];
---

<section class="lab-how" aria-labelledby="lab-how-title">
  <div class="container">
    <div class="lab-how__head">
      <p class="kicker lab-how__kicker">{t.how.kicker}</p>
      <h2 id="lab-how-title" class="display display--m" set:html={inline(t.how.title)} />
    </div>
    <ol class="lab-how__items" role="list">
      {
        t.how.items.map((item, i) => (
          <li>
            <span class="lab-how__icon" aria-hidden="true">
              <Icon name={icons[i] ?? 'check'} size={20} tone={icons[i] === 'sparkle' ? 'sun' : 'current'} />
            </span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="lab-how__contact">
      {t.how.contact} <a href={`mailto:${common.contact.email}`}>{common.contact.email}</a>
    </p>
  </div>
</section>

<style>
  .lab-how {
    padding-block: var(--space-section-sm) var(--space-section);
    border-top: var(--border-hair) solid var(--color-rule);
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-bg-sunken) 60%, transparent), transparent 70%);
  }

  .lab-how__head {
    display: grid;
    gap: var(--space-s);
    margin-bottom: var(--space-xl);
  }

  .lab-how__kicker {
    color: var(--color-green-ink);
  }

  .lab-how__items {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--layout-gap);
    margin: 0;
  }

  .lab-how__items li {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
    padding-top: var(--space-m);
    border-top: var(--border-hair) solid var(--color-rule-section);
  }

  .lab-how__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--space-2xs);
    border: var(--border-hair) solid color-mix(in srgb, var(--color-glow) 55%, transparent);
    border-radius: var(--radius-round);
    color: var(--color-green-ink);
    box-shadow: 0 0 24px -6px color-mix(in srgb, var(--color-glow) 55%, transparent);
  }

  .lab-how__items h3 {
    font-size: calc(var(--fs-lg) * var(--fs-scale, 1));
  }

  .lab-how__items p {
    font-size: var(--fs-sm);
    color: var(--color-text-body);
  }

  .lab-how__contact {
    margin-top: var(--space-xl);
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 63.99em) {
    .lab-how__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-l);
    }
  }

  @media (max-width: 39.99em) {
    .lab-how__items {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
